# Secrets and local state never go into an image.
.env
.env.*
!.env.example
.git
.claude
**/.DS_Store
*.pdf
*.jpg

# Built inside the image (ui stage); local builds would only bloat the context.
frontend/node_modules
frontend/dist
internal/webui/dist/*
!internal/webui/dist/.gitkeep
bin/
prototypes/
compare/
