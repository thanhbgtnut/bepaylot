# Copy to .env; the Makefile exports it.
DATABASE_URL=postgres://bepilot:bepilot@localhost:5433/bepilot?sslmode=disable
BEPILOT_ENV=development
BEPILOT_HTTP_ADDR=:8080
BEPILOT_LOG_FORMAT=text
BEPILOT_LOG_LEVEL=info
BEPILOT_SKILLS_DIR=skills
BEPILOT_AUTH_BYPASS=false

# LLM: fake (offline) | claude | openai
BEPILOT_DEFAULT_PROVIDER=fake
BEPILOT_DEFAULT_MODEL=bepilot-fake-1
BEPILOT_EMBEDDING_KIND=hash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Task queue (asynq). Empty = in-process tasks (single instance, dev only).
REDIS_ADDR=localhost:6380

# Object storage (MinIO from deploy/docker-compose.yml). Empty bucket = in-memory (dev only).
S3_ENDPOINT=http://localhost:9110
S3_REGION=us-east-1
S3_BUCKET=bepilot
S3_ACCESS_KEY=bepilot
S3_SECRET_KEY=bepilot-secret

# OCR (TurboOCR POST /ocr/raw)
TURBOOCR_URL=http://10.215.122.20:30189

# PDF rendering: webassembly (no cgo, default) | multi_threaded (needs bin/pdfium-worker)
BEPILOT_RENDER_MODE=webassembly
# BEPILOT_PDFIUM_WORKER=bin/pdfium-worker

# api | worker | all
BEPILOT_ROLE=all
