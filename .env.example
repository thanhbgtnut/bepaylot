# Copy to .env; the Makefile exports it.
DATABASE_URL=postgres://bepaylot:bepaylot@localhost:5433/bepaylot?sslmode=disable
BEPAYLOT_ENV=development
BEPAYLOT_HTTP_ADDR=:8080
BEPAYLOT_LOG_FORMAT=text
BEPAYLOT_LOG_LEVEL=info
BEPAYLOT_SKILLS_DIR=skills
BEPAYLOT_AUTH_BYPASS=false
# Comma-separated emails allowed to call /v1/admin/* (queues, dead letters)
BEPAYLOT_ADMIN_EMAILS=

# Sign-in (login page /login). Empty JWT secret = generated once and kept in the DB.
BEPAYLOT_JWT_SECRET=
# open | closed (closed = no self sign-up; accounts via OIDC or make seed)
BEPAYLOT_REGISTRATION=open
# OIDC (Keycloak, Google, Azure AD, Authentik…). Register the callback
# http://localhost:5174/v1/auth/oidc/callback (dev, via Vite) at the provider.
BEPAYLOT_OIDC_ENABLED=false
BEPAYLOT_OIDC_DISPLAY_NAME=SSO
BEPAYLOT_OIDC_ISSUER_URL=
BEPAYLOT_OIDC_CLIENT_ID=
BEPAYLOT_OIDC_CLIENT_SECRET=
# BEPAYLOT_OIDC_SCOPES=openid,email,profile
# BEPAYLOT_OIDC_REDIRECT_URL=
# BEPAYLOT_OIDC_FRONTEND_URL=

# LLM: fake (offline) | claude | openai
BEPAYLOT_DEFAULT_PROVIDER=fake
BEPAYLOT_DEFAULT_MODEL=bepaylot-fake-1
BEPAYLOT_EMBEDDING_KIND=hash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Task queue (asynq). Empty = in-process tasks (single instance, dev only).
REDIS_ADDR=localhost:6380
# Must match the password of the Redis container (deploy/docker-compose.yml defaults to "bepaylot").
# REDIS_USERNAME is only needed for Redis ACL users (empty = "default").
REDIS_USERNAME=
REDIS_PASSWORD=bepaylot
REDIS_DB=0

# Object storage (MinIO from deploy/docker-compose.yml). Empty bucket = in-memory (dev only).
S3_ENDPOINT=http://localhost:9110
S3_REGION=us-east-1
S3_BUCKET=bepaylot
S3_ACCESS_KEY=bepaylot
S3_SECRET_KEY=bepaylot-secret
# true = create the bucket when missing (local MinIO only). Leave empty where the bucket
# exists and the keys may only read/write objects.
BEPAYLOT_S3_CREATE_BUCKET=true
# empty/true = migrate at start; false = the DB user has no DDL rights (run -migrate-only separately)
BEPAYLOT_DB_AUTO_MIGRATE=

# OCR (TurboOCR POST /ocr/raw)
TURBOOCR_URL=http://10.215.122.20:30189
# VLM for engine turboocr_vlm: llm provider "vlm" (OpenAI-compatible, e.g. LM Studio / vLLM
# serving allenai/olmocr-2-7b). Regions are read through the agent (streaming).
VLM_BASE_URL=http://localhost:1234/v1
VLM_API_KEY=
# Provider for the engine: empty = "vlm" when VLM_BASE_URL is set; or e.g. openai (a vision model)
BEPAYLOT_VLM_PROVIDER=
BEPAYLOT_VLM_MODEL=allenai/olmocr-2-7b
# Pages whose PDF text layer is good skip the VLM: empty/true = skip, false = always call the VLM
BEPAYLOT_VLM_SKIP_WITH_TEXT_LAYER=
# turboocr (default) | turboocr_vlm
BEPAYLOT_OCR_ENGINE=

# PDF rendering: webassembly (no cgo, default) | multi_threaded (needs bin/pdfium-worker)
BEPAYLOT_RENDER_MODE=webassembly
# BEPAYLOT_PDFIUM_WORKER=bin/pdfium-worker

# api | worker | all
BEPAYLOT_ROLE=all

# Document completion callback (optional per upload: form field callback_url)
BEPAYLOT_CALLBACK_SECRET=
# true lets callbacks reach localhost/private IPs (dev only)
BEPAYLOT_CALLBACK_ALLOW_PRIVATE=true

# Decision API (classify.decision): reads the document type of each page from its
# image, for KBs that have doc_types. Empty URL = pages are not classified.
DECISION_API_URL=
DECISION_API_MODEL=cloudflare_clef-flash
# true = never run page classification and OCR at the same time (one local model
# server, e.g. LM Studio, that cannot hold both models). Empty = run them together.
DECISION_API_SERIAL=
